{
  "buildCommand": "pnpm install && pnpm -r run build",
  "outputDirectory": "artifacts/netco/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://netco.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
